# Copy this file to .env (which is git-ignored) and fill in your keys. Never commit .env.
ORS_API_KEY=
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=

# Optional settings. Leave them out to use the defaults.
# AGENT_MODEL=claude-sonnet-5
# AGENT_EFFORT=medium
# PLANS_PER_IP_PER_HOUR=8
# PLANS_PER_DAY=150
# AGENT_DAILY_TOKENS=2000000
# A long random secret turns on the admin endpoints that run the AI-vs-planner comparison (they spend money):
# ADMIN_TOKEN=
# EVAL_RESULTS_DIR=
# Prices in USD per million tokens, to see a cost estimate in the log (check your model's prices):
# ANTHROPIC_PRICE_INPUT_PER_MTOK=
# ANTHROPIC_PRICE_OUTPUT_PER_MTOK=
# ANTHROPIC_PRICE_CACHE_READ_PER_MTOK=
# ANTHROPIC_PRICE_CACHE_WRITE_PER_MTOK=
